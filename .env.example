# ============================
# NovaMovies - Environment Variables
# ============================

# MongoDB Connection
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/novamoviess

# NextAuth
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# OMDB API (https://www.omdbapi.com/apikey.aspx - Free tier available)
OMDB_API_KEY=your_omdb_api_key

# Fanart.tv API (https://fanart.tv/get-an-api-key/ - Free)
FANART_API_KEY=your_fanart_api_key

# TMDB API (https://www.themoviedb.org/settings/api - Free)
TMDB_API_KEY=your_tmdb_api_key

# Discord Webhook URL (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Admin Credentials (Default admin seeded on first run)
ADMIN_EMAIL=youseffahmed74@proton.me
ADMIN_PASSWORD=Admin@2024!

# Socket.io Server Port
SOCKET_PORT=3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=NovaMovies
